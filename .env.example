NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_PAYPAL_CLIENT_ID=

# Cloudflare D1: use a DB binding named DB when deployed to Cloudflare.
# These values provide the REST API fallback for local/Node deployments.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2/Stream delivery worker that validates generated HMAC queries.
CLOUDFLARE_MEDIA_BASE_URL=
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Store these as Cloudflare encrypted secrets in production.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
CLOUDFLARE_ACCESS_REQUIRED=false
