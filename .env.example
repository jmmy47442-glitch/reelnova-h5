NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_PAYPAL_CLIENT_ID=

# Production site: https://iseedrama.com
# Admin: https://admin.iseedrama.com
# Media Worker: https://media.iseedrama.com
# Route www.iseedrama.com to the apex domain with a permanent redirect.

# Cloudflare D1: use a DB binding named DB when deployed to Cloudflare.
# These values provide the REST API fallback for local/Node deployments.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=195dc8829b5b019c7d2ea29d8fe14101
# Cloudflare for SaaS fallback/CNAME target; this is assigned by Cloudflare and
# is not the public site domain itself.
CLOUDFLARE_DOMAIN_CNAME_TARGET=

# Prototype catalogue fallback is development-only and production is forced off.
# Seed D1 with `npm run db:seed:acceptance` before public deployment. Transaction
# fixtures are opt-in via `npm run db:seed:acceptance:transactions` and must not
# be loaded into a customer-facing database.
REELNOVA_PUBLIC_MOCK_FALLBACK=false

# Cloudflare R2 upload Worker, Stream playback and short-lived playback signing.
# Leave these blank before R2/Stream is provisioned; admin uploads stay disabled.
CLOUDFLARE_MEDIA_WORKER_URL=https://media.iseedrama.com
CLOUDFLARE_MEDIA_WORKER_SECRET=
# Optional fallback for Stream delivery. New ready assets can use Stream's
# returned HLS URL even when this is blank.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_WEBHOOK_URL=https://iseedrama.com/api/media/stream-webhook
CLOUDFLARE_MEDIA_BASE_URL=
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Leave these blank before PayPal is approved; checkout stays unavailable and no
# failed local order is created. The two Client ID values must be identical.
# Store server values as Cloudflare encrypted secrets in production.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Configure both environments before using the switch in /admin/system. The
# legacy values above remain a fallback for PAYPAL_ENVIRONMENT only.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
NUXT_PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_PRODUCTION_CLIENT_ID=
PAYPAL_PRODUCTION_SECRET=
PAYPAL_PRODUCTION_WEBHOOK_ID=
NUXT_PUBLIC_PAYPAL_PRODUCTION_CLIENT_ID=
CLOUDFLARE_ACCESS_REQUIRED=false
# Required for production admin API JWT verification. Use the Access team
# issuer URL (for example https://example.cloudflareaccess.com) and the
# application AUD tag configured in Cloudflare Access.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=

# Optional administrator bootstrap overrides. When omitted, the historical
# bootstrap account is used.
SUPER_ADMIN_EMAIL=admin@iseedrama.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=ReelNova Super Administrator
ADMIN_SESSION_SECRET=
ADMIN_CREDENTIAL_SECRET=
USER_SESSION_SECRET=
